# Covenant Path — React web app config (Vite). Copy to `.env` (gitignored) for local dev.
# These mirror the Flutter app's --dart-define values. The anon/publishable key is safe on
# clients — Postgres RLS does the access gating. Never put the service-role key here.

# Supabase project (required). Same project the backend syncs into.
#   VITE_SUPABASE_URL=https://<ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Church-login auth broker (backend/auth_broker). Empty => only Email-code login is shown
# (Church-account + passkey login require the broker). e.g. https://broker.membercovenantpath.org
VITE_BROKER_URL=

# Sentry browser DSN (optional — a DSN is not a secret, it's designed to live on the client).
# Empty => Sentry init is skipped. Defaults are not baked in; set per deployment if desired.
VITE_SENTRY_DSN=
