# Cloudflare Pages headers. Flutter web's service worker decides when to pull a new build
# by re-fetching flutter_service_worker.js; if that file is edge/browser-cached (Pages
# defaults to max-age=14400) the app stays stale for hours after a deploy. Force the
# version-controlling files to revalidate every load so a normal reload picks up new builds.
/index.html
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
