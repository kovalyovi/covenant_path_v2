# Copy to .env and fill in.

# --- LCR portal (password-only account, no 2FA) ---
LCR_LOGIN="your_lcr_username"
LCR_PASSWORD="your_lcr_password"

# --- Delegated-access token store encryption (lcr_client/token_store.py) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CP_TOKEN_KEY=""

# --- Google Sheets sync (sheets_sync/) ---
# Path to the service-account JSON; the SA email must be Editor on the target sheet.
SHEETS_SERVICE_ACCOUNT="sheets_sync/service_account.json"

# --- Supabase backend (backend/) ---
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."          # publishable/anon key (RLS-scoped reads)
SUPABASE_SERVICE_ROLE_KEY=""                     # REQUIRED by the auth broker (mints login sessions); also admin ops
# Settings -> Database -> Connection string (URI). For CI/IPv4 use the SHARED POOLER:
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# --- Email via SMTP (no domain required) ---
# Fastest: Gmail App Password (Google account -> Security -> App Passwords), ~500/day.
# Alt: Brevo (smtp-relay.brevo.com, free 300/day). Or Resend SMTP once you verify a domain.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS=""                                  # Gmail App Password (16 chars)
SMTP_FROM="Covenant Path <you@gmail.com>"     # with Gmail, must be your gmail address
APP_URL="https://your-viewer.example.com"     # used in invitation links

# Admin/support + reminder recipient (no hardcoded default in source). Set OWNER_EMAIL on the
# broker (admin-access approvals + support inbox; also seeds the first app_admin via backend.apply)
# and REMINDER_OWNER wherever the weekly digest runs (owner-only review recipient until REMINDER_ALL=1).
OWNER_EMAIL=""
REMINDER_OWNER=""

# Resend (only once you OWN + verify a domain — then point SMTP_* at smtp.resend.com,
# user 'resend', pass = this key, SMTP_FROM = noreply@yourdomain). See docs/CUSTOM_API_KEYS.md.
RESEND_API_KEY="re_..."

# --- Church-login auth broker (backend/auth_broker) — see docs/DEPLOYMENT.md ---
# Needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (above). CORS already allows
# *.membercovenantpath.org, *.pages.dev, and localhost; add extra exact origins here if needed.
ALLOWED_ORIGINS=""                               # comma-separated extra exact origins (optional)
# Ops kill switch for the login calling gate (enroll._clearly_no_calling): set to 1 ONLY if a
# legitimate leader is ever false-blocked at sign-in; logins then fall back to the pre-0044
# behavior (RLS still hides all data from no-role accounts).
CP_DISABLE_CALLING_GATE=""
# How long a FIRST (uncached) login waits for the synchronous user_context-only calling gate before
# proceeding (a no-calling member is blocked within this; on timeout the login proceeds and the
# background eval still audits). Repeat logins skip it (zero-LCR cached fast block). Default 12s.
LOGIN_GATE_BUDGET_SECONDS=""
# The web app (apps/web, React/Vite) points at the broker at BUILD time, not via this .env:
#   VITE_BROKER_URL=https://covenant-path-broker.onrender.com npm run build   (see deploy-web.yml)

# --- Admin / ops console (broker /admin/*) — optional; the console still loads without these ---
# Fine-grained PAT scoped to ONLY this repo: Actions read+write, Contents read. Server-side only.
GITHUB_TOKEN=""
GITHUB_REPO="kovalyovi/covenant_path_v2"         # owner/name the console runs Actions / files issues against
# Operator master Google Sheet id (per-stake sheets are created/owned per stake via OAuth Drive).
SPREADSHEET_ID=""

# --- Passkeys (WebAuthn) — broker mints a Supabase session on success ---
# Relying-party id = the app's domain, NO scheme (e.g. app.membercovenantpath.org).
WEBAUTHN_RP_ID=""

# --- Render logs API (tools/render_logs.py) — pull broker logs without the dashboard ---
# Create at Render Dashboard -> Account Settings -> API Keys. Local-only (incident digs);
# the service is auto-discovered by name, pin with RENDER_SERVICE_ID=srv-... if ambiguous.
RENDER_API_KEY=""                                # rnd_...
RENDER_SERVICE_ID=""                             # optional srv-... pin

# --- Structured logging → Axiom (optional; see docs/LOGGING_SETUP.md) ---
# Backend/sync + broker ship PII-safe JSON events to Axiom. No-op when AXIOM_TOKEN is unset.
# Set AXIOM_TOKEN here (local), as a GitHub Actions secret (CI sync logs), and on the Render
# broker (client error proxy). AXIOM_DATASET defaults to "covenant-path" — only set if different.
# For the in-app log VIEWS, the token must also have QUERY scope on the dataset.
AXIOM_TOKEN=""                                   # xaat-... (ingest; + query scope for in-app views)
AXIOM_DATASET="covenant-path"                    # optional; this is the default

# Sentry (React web crash/error reporting via @sentry/react). The DSN is client-safe; the web build
# reads it as VITE_SENTRY_DSN (apps/web/src/lib/config.ts) — deploy-web.yml passes the SENTRY_DSN
# GitHub secret through as VITE_SENTRY_DSN. Empty disables Sentry. Kept here for reference / CI parity.
SENTRY_DSN="https://<key>@o<org>.ingest.us.sentry.io/<project>"

# --- M7: per-stake Google Drive OAuth (docs/M7_OAUTH_DRIVE.md) ---
# A leader connects their Google account; the stake's sheet is created + owned in THEIR Drive.
# Create an OAuth 2.0 Client ID (Web application) in GCP with redirect = GOOGLE_OAUTH_REDIRECT.
# Set all three on the BROKER (Render) AND as GitHub Actions secrets (the sync refreshes the token).
# Needs CP_TOKEN_KEY on the broker too (the refresh token is envelope-encrypted with it). No-op
# until CLIENT_ID/SECRET are set.
GOOGLE_OAUTH_CLIENT_ID="<id>.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT="https://covenant-path-broker.onrender.com/auth/google/callback"

# --- E2E test environment (docs/TESTING.md) — NEVER set CP_TEST_MODE on Render/CI-sync ---
# CP_TEST_MODE=1 unlocks the host overrides below so the e2e suite can point the REAL
# client/broker code at the local mock LCR/Okta (tests/mock_lcr). Without CP_TEST_MODE the
# overrides are IGNORED (tools/test_suite.py::test_hosts_test_mode_guard asserts this).
CP_TEST_MODE=""
CP_TEST_LCR_BASE=""                              # e.g. http://127.0.0.1:9100 (mock LCR)
CP_TEST_IDENTITY_BASE=""                         # e.g. http://127.0.0.1:9101 (mock Okta)

# Dedicated TEST Supabase project (free tier) for the RLS-matrix + fullstack e2e lanes.
# Create a SECOND project (never the production one!); tests/seed.py refuses to run when
# CP_TEST_SUPABASE_URL is unset or equals SUPABASE_URL. Mirror these as GitHub Actions secrets.
CP_TEST_SUPABASE_URL=""
CP_TEST_SUPABASE_ANON_KEY=""
CP_TEST_SUPABASE_SERVICE_ROLE_KEY=""
CP_TEST_SUPABASE_DB_URL=""                       # IPv4 shared pooler, for python -m backend.apply

# B8 credential-longevity nudge: after a HEALTHY delegated sync, email the provider when their
# stored session is older than this many days AND has no refresh token (it cannot self-renew) —
# once per stored session (re-enrolling re-arms it). 0 disables. Default 21.
CP_CREDENTIAL_AGE_ALERT_DAYS="21"
